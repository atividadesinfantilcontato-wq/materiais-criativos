rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras da coleção de produtos / materiais
    match /products/{productId} {
      // Leitura pública permitida para produtos publicados, ou qualquer leitura para admin autenticado
      allow read: if resource == null || resource.data.status == "published" || request.auth != null;
      
      // Escrita (criar, editar, deletar) restrita a administradores ativos
      allow write: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Regras da coleção de eventos de analytics
    match /analyticsEvents/{eventId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin" &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Regras da coleção de administradores
    match /admins/{userId} {
      // Usuário autenticado só pode ler seu próprio documento de verificação
      allow read: if request.auth != null && request.auth.uid == userId;
      // Nenhuma alteração via cliente público nas permissões de admin
      allow write: if false;
    }
  }
}
